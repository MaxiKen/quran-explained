__pycache__/
*.pyc

# Scratch. Source digests (tmp/sources/), run maps (tmp/runs/) and caches are
# rebuilt with one command, so they stay out of git. The drafting bench under
# tmp/work/ is the live state of the writing — verse drafts and the helpers that
# splice them into the chapter file — and a wiped scratch dir used to lose them,
# so the bench is tracked through the exceptions below.
tmp/*
!tmp/work/
tmp/work/*
!tmp/work/*.md
!tmp/work/*.py
!tmp/work/*.txt
