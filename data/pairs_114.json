{"surah":114,"verses":{"1":{"phrases":[{"text":"Say, ˹O Prophet,˺ “I seek refuge in the Lord of humankind","ar":"","head":"","parts":[]}]},"2":{"phrases":[{"text":"the Master of humankind","ar":"","head":"","parts":[]}]},"3":{"phrases":[{"text":"the God of humankind","ar":"","head":"","parts":[]}]},"4":{"phrases":[{"text":"from the evil of the lurking whisperer","ar":"","head":"","parts":[]}]},"5":{"phrases":[{"text":"who whispers into the hearts of humankind","ar":"","head":"","parts":[]}]},"6":{"phrases":[{"text":"from among jinn and humankind.”","ar":"","head":"","parts":[]}]}}}