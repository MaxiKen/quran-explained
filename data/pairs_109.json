{"surah":109,"verses":{"1":{"phrases":[{"text":"Say, ˹O Prophet,˺ “O you disbelievers","ar":"","head":"","parts":[]}]},"2":{"phrases":[{"text":"I do not worship what you worship","ar":"لا أَعْبُدُ مَا تَعْبُدُونَ","head":"","parts":[0]}]},"3":{"phrases":[{"text":"nor do you worship what I worship","ar":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ","head":"","parts":[1,2]}]},"4":{"phrases":[{"text":"I will never worship what you worship","ar":"","head":"","parts":[3,4,7]}]},"5":{"phrases":[{"text":"nor will you ever worship what I worship","ar":"","head":"","parts":[]}]},"6":{"phrases":[{"text":"You have your way,","ar":"","head":"","parts":[]},{"text":"and I have my Way.”","ar":"","head":"","parts":[]}]}}}