          "source_fingerprint": "",
          "source_excerpt": "",
          "support": "pending",
          "rationale": ""
        },
        {
          "statement": "Mujāhid takes the reference to be prayer, the nearest named act, and that is the most direct reading here.",
          "proposition": "",
          "source": "",
          "source_reference": "2:45",
          "source_fingerprint": "",
          "source_excerpt": "",
          "support": "pending",
          "rationale": ""
