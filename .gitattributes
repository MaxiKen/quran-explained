# The six-source tafsir payloads are generated and are single-line JSON by
# design (31 MB across 114 files). GitHub hides over-long lines in diffs, so
# they render as blank and look as though nothing was pushed. Marking them
# makes that explicit instead of alarming.
data/tafsir_*.json -diff linguist-generated
data/chapter_*.js linguist-generated

# data/guidance_*.json carries no generated commentary any more — 112 is the
# only file left, an empty placeholder — so it is pretty-printed and diffs
# normally.
data/guidance_*.json -linguist-generated
